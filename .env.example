# Copy to .env and fill in real values. Never commit .env.

# Required: Google AI Studio key (https://aistudio.google.com/apikey)
# Used for /api/chat, /api/upload and /api/nearby-care.
GEMINI_API_KEY=

# Optional: Flask session signing key. A random value is generated if unset.
SECRET_KEY=

# Optional: comma separated list of origins allowed to call /api/*.
# Leave empty to allow any origin (local development only).
ALLOWED_ORIGINS=

# Optional: per-client request ceiling for the Gemini-backed routes, per minute.
RATE_LIMIT_PER_MINUTE=20

# Optional: bind address and port for `python app.py`.
HOST=127.0.0.1
PORT=5000

# Optional: set to 1 to enable the Werkzeug debugger. Never do this in production.
FLASK_DEBUG=0