# Copy to .env and fill in real values. Never commit .env.

# Required: Google AI Studio key (https://aistudio.google.com/apikey).
# Used by /api/chat, /api/upload and /api/nearby-care.
GEMINI_API_KEY=

# Optional: Gemini model for every route. Google Maps grounding needs a model
# that supports the googleMaps tool.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: comma separated origins allowed to call /api/* cross-origin.
# Leave empty: the bundled UI is same-origin and needs no CORS.
ALLOWED_ORIGINS=

# Optional: requests per client per minute on the Gemini-backed routes.
RATE_LIMIT_PER_MINUTE=20

# Set to the number of reverse proxies in front of the app (1 on Heroku/Render)
# so rate limiting sees real client IPs. Keep 0 when exposed directly.
TRUST_PROXY_HOPS=0

# Optional: expose the /debug model diagnostics page.
ENABLE_DEBUG_PAGE=0

# Optional: bind address and port for `python app.py`.
HOST=127.0.0.1
PORT=5000

# Optional: Werkzeug debugger. Never enable in production.
FLASK_DEBUG=0
LOG_LEVEL=INFO
